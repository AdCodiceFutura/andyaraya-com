---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionShell from '../components/SectionShell.astro';
import MindmapGraph from '../components/MindmapGraph.astro';
import CredentialsSection from '../components/CredentialsSection.astro';
import StrategicCaseStudies from '../components/StrategicCaseStudies.astro';
import BooksCarousel from '../components/BooksCarousel.astro';
import ExperienceDial from '../components/ExperienceDial.astro';
import { educationEntries, personalStory } from '../data/about';
import { contactChannels } from '../data/contact';

const personalStoryParagraphs = personalStory.split('\n\n');
const educationBadge = educationEntries[0];
const contactIcons = {
  Email: {
    paths: ['M4 6.5h16v11H4z', 'm4.5 7 7.5 6 7.5-6', 'm4.5 17 5.4-5.1', 'm19.5 17-5.4-5.1']
  },
  Phone: {
    paths: [
      'M7.7 4.5 10 8.9l-1.35 1.35c.9 1.9 2.25 3.25 4.15 4.15L14.1 13l4.45 2.3c.3.15.48.47.42.8-.18 1.18-.62 2.2-1.32 3.06-.36.44-.92.66-1.48.6C9.5 19.05 4.95 14.5 4.24 7.83c-.06-.56.16-1.12.6-1.48.86-.7 1.88-1.14 3.06-1.32.33-.06.65.12.8.42Z'
    ]
  },
  Location: {
    paths: [
      'M12 21s6-5.34 6-10.5A6 6 0 0 0 6 10.5C6 15.66 12 21 12 21Z',
      'M12 13.1a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z'
    ]
  },
  LinkedIn: {
    paths: [
      'M6.2 9.9h3.2v9.1H6.2z',
      'M7.8 8.5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5Z',
      'M11.2 9.9h3.05v1.24c.45-.72 1.35-1.44 2.78-1.44 2.15 0 3.77 1.4 3.77 4.42V19h-3.18v-4.46c0-1.2-.43-2.02-1.5-2.02-.82 0-1.3.55-1.52 1.08-.08.2-.1.47-.1.73V19h-3.3z'
    ]
  }
} as const;
const aboutHighlightBadges = [
  {
    mark: 'ED',
    title: educationBadge.title,
    detail: educationBadge.issuer,
    status: 'Education',
    accent: '#f59e0b'
  },
  {
    mark: '10+',
    title: 'Creative & Digital Projects',
    detail: '10+ years leading',
    status: 'Leadership',
    accent: '#22d3ee'
  },
  {
    mark: 'PD',
    title: 'Project Director',
    detail: 'PROSESO since 2021',
    status: 'Current Role',
    accent: '#9d4dff'
  },
  {
    mark: 'MX',
    title: 'Multinational Clients',
    detail: 'Unilever & Essity',
    status: 'Experience',
    accent: '#34d399'
  }
] as const;
---

<BaseLayout
  title="Andy Araya | Creative Technologist, AI Systems Builder, Digital Product Strategist"
  description="Andy Araya's professional website: a dark cinematic portfolio for creative technology, AI automation, product strategy, and digital leadership."
>
  <Hero />

  <SectionShell
    id="credentials"
    eyebrow="01 / Credentials"
    title="Verified foundations for building modern systems"
    intro="Selected credentials supporting the intersection of business strategy, software development, AI systems and digital product creation."
  >
    <CredentialsSection />
  </SectionShell>

  <SectionShell
    id="mindmap"
    eyebrow="02 / Mindmap"
    title="The architecture of my thinking"
    intro="Every product, workflow and automation starts with a network of connected ideas. This map reveals the disciplines and concepts that influence my work."
  >
    <MindmapGraph />
  </SectionShell>

  <SectionShell
    id="case-studies"
    eyebrow="03 / Business Value / Product Strategy / AI Systems"
    title="Strategic Case Studies"
    intro="Business challenges analyzed through product management, systems thinking, AI strategy, and value-driven decision frameworks."
  >
    <StrategicCaseStudies />
  </SectionShell>

  <SectionShell
    id="books"
    eyebrow="04 / Strategic Reading"
    title="A strategic reading system behind the work"
    intro="An ongoing collection of ideas that continue to shape how I think about strategy, systems, product, AI and long-term value creation."
  >
    <BooksCarousel />
  </SectionShell>

  <SectionShell
    id="about"
    eyebrow="05 / Why I think this way"
    title="Connecting the dots"
    intro="A multidisciplinary path through design, business, technology and systems thinking."
  >
    <div class="space-y-7" data-stagger>
      <article class="max-w-4xl" data-reveal-child>
        <div class="mt-4 max-w-3xl space-y-5 text-sm leading-7 text-white/72 sm:text-base">
          {personalStoryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <div class="about-badge-runway py-4" data-stagger>
        <div class="about-badge-line">
          {aboutHighlightBadges.map((item, index) => (
            <div
              class="about-badge"
              style={`--about-accent: ${item.accent}; --about-delay: ${index * 340}ms`}
              data-reveal-child
            >
              <span class="about-badge-glow" aria-hidden="true"></span>
              <span class="about-badge-crown" aria-hidden="true">{item.mark}</span>
              <span class="about-badge-title">{item.title}</span>
              <span class="about-badge-detail">{item.detail}</span>
              <span class="about-badge-status">{item.status}</span>
            </div>
          ))}
        </div>
      </div>

      <ExperienceDial />
    </div>
  </SectionShell>

  <SectionShell
    id="contact"
    eyebrow="06 / Contact"
    title="Let's build together"
    intro="Seeking opportunities to contribute, lead and help organizations move faster through better systems and technology."
  >
    <div class="max-w-6xl space-y-6" data-stagger>
      <div class="space-y-4 text-lg leading-8 text-white/72" data-reveal-child>
        <p>My strongest work happens when strategy, execution and technology are aligned around a shared goal.</p>
        <p>I am interested in joining teams that value systems thinking, continuous improvement and practical innovation.</p>
      </div>
      <div class="contact-grid" data-stagger>
        {contactChannels.map((channel) => (
          <a
            href={channel.href}
            target={channel.href.startsWith('http') ? '_blank' : undefined}
            rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="contact-card glass-card hover-depth rounded-[1rem]"
            data-reveal-child
          >
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                {contactIcons[channel.label].paths.map((path) => (
                  <path d={path}></path>
                ))}
              </svg>
            </span>
            <span class="contact-card__copy">
              <span class="contact-card__value">{channel.value}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </SectionShell>
</BaseLayout>

<style>
  .about-badge-runway {
    position: relative;
  }

  .contact-card {
    display: inline-flex;
    box-sizing: border-box;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
    width: max-content;
    max-width: 100%;
    min-height: 2.85rem;
    gap: 0.58rem;
    padding: 0.58rem 0.76rem;
    border-color: rgba(255, 255, 255, 0.095);
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.035), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.022));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.075),
      0 12px 30px rgba(0, 0, 0, 0.22);
  }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: flex-start;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contact-card__icon {
    display: grid;
    flex: 0 0 auto;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background:
      radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.14), transparent 34%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 8px 18px rgba(0, 0, 0, 0.18);
    color: rgba(255, 255, 255, 0.72);
  }

  .contact-card__icon svg {
    display: block;
    width: 0.74rem;
    height: 0.74rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.85;
  }

  .contact-card__copy {
    display: block;
    min-width: 0;
  }

  .contact-card__value {
    display: block;
    min-width: 0;
    white-space: nowrap;
    color: white;
    font-size: clamp(0.78rem, 0.82vw, 0.84rem);
    font-weight: 450;
    line-height: 1;
  }

  @media (max-width: 639px) {
    .contact-grid {
      gap: 0.85rem;
      align-items: flex-start;
    }

    .contact-card {
      width: auto;
      min-width: 0;
      max-width: 100%;
      min-height: 2.75rem;
      gap: 0.54rem;
      padding: 0.56rem 0.72rem;
    }

    .contact-card__icon {
      width: 1.48rem;
      height: 1.48rem;
    }

    .contact-card__value {
      font-size: 0.8rem;
      white-space: normal;
    }
  }

  .about-badge-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10.9rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    justify-items: center;
    isolation: isolate;
    padding: 0;
  }

  .about-badge {
    --about-accent: #22d3ee;
    position: relative;
    display: grid;
    width: 11.8rem;
    min-height: 11.4rem;
    max-width: 100%;
    place-items: center;
    align-content: start;
    padding: 1.18rem 1.05rem 0.72rem;
    color: white;
    text-align: center;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.3));
    animation: about-badge-float 6.8s ease-in-out infinite;
    animation-delay: var(--about-delay, 0ms);
    isolation: isolate;
    transition:
      transform 420ms var(--motion-ease),
      filter 420ms var(--motion-ease);
  }

  .about-badge::before,
  .about-badge::after {
    content: "";
    position: absolute;
    transition:
      transform 420ms var(--motion-ease),
      background 420ms var(--motion-ease),
      opacity 420ms var(--motion-ease);
  }

  .about-badge::before {
    inset: 0.24rem 0.64rem auto;
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle at 38% 28%, rgba(255, 255, 255, 0.52), transparent 22%),
      radial-gradient(circle at 62% 72%, color-mix(in srgb, var(--about-accent) 34%, transparent), transparent 38%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.08) 52%, color-mix(in srgb, var(--about-accent) 18%, rgba(255, 255, 255, 0.08)));
    border: 1px solid color-mix(in srgb, var(--about-accent) 26%, rgba(255, 255, 255, 0.36));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.52),
      inset 0 -28px 48px color-mix(in srgb, var(--about-accent) 16%, rgba(10, 12, 18, 0.18)),
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 18px 42px rgba(0, 0, 0, 0.24),
      0 0 28px color-mix(in srgb, var(--about-accent) 18%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    animation: about-badge-pulse 4.8s ease-in-out infinite;
    animation-delay: calc(var(--about-delay, 0ms) * -0.65);
    opacity: 1;
    z-index: 0;
  }

  .about-badge::after {
    inset: 1rem 1.42rem auto;
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle at 40% 30%, rgba(255, 255, 255, 0.34), transparent 24%),
      radial-gradient(circle at 64% 68%, color-mix(in srgb, var(--about-accent) 18%, transparent), transparent 42%),
      rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -18px 34px color-mix(in srgb, var(--about-accent) 10%, transparent);
    animation: about-badge-inner-pulse 5.4s ease-in-out infinite;
    animation-delay: calc(var(--about-delay, 0ms) * -0.8);
    opacity: 0.7;
    z-index: 1;
    transition:
      transform 420ms var(--motion-ease),
      background 420ms var(--motion-ease),
      opacity 420ms var(--motion-ease);
  }

  .about-badge:hover {
    transform: translateY(-5px) scale(1.018);
    filter:
      drop-shadow(0 18px 26px rgba(0, 0, 0, 0.32))
      drop-shadow(0 0 15px color-mix(in srgb, var(--about-accent) 38%, transparent));
  }

  .about-badge:hover::before {
    transform: scale(1.018);
  }

  .about-badge-glow {
    position: absolute;
    inset: 0.45rem 1.4rem auto;
    height: 5.8rem;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--about-accent) 30%, white 14%), transparent 70%);
    animation: about-badge-glow-breathe 4.8s ease-in-out infinite;
    animation-delay: calc(var(--about-delay, 0ms) * -0.65);
    opacity: 0.5;
    z-index: 2;
  }

  .about-badge-crown,
  .about-badge-title,
  .about-badge-detail,
  .about-badge-status {
    position: relative;
    z-index: 3;
  }

  .about-badge-crown {
    order: 1;
    display: grid;
    width: 1.72rem;
    height: 1.72rem;
    margin-top: 0.54rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--about-accent) 42%, rgba(255, 255, 255, 0.62));
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.44rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 8px 16px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .about-badge-title {
    order: 2;
    display: block;
    width: 8.35rem;
    min-height: 2.42rem;
    margin-top: 0.84rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.12;
    text-wrap: balance;
  }

  .about-badge-detail {
    order: 3;
    display: block;
    width: 7.8rem;
    min-height: 0.78rem;
    margin-top: 0.04rem;
    color: color-mix(in srgb, var(--about-accent) 46%, rgba(255, 255, 255, 0.86));
    font-size: 0.35rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.22;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .about-badge-status {
    order: 4;
    margin-top: 0.08rem;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.32rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  @keyframes about-badge-float {
    0%,
    100% {
      transform: translateY(0) rotate(-0.15deg);
    }

    45% {
      transform: translateY(-0.42rem) rotate(0.18deg);
    }

    70% {
      transform: translateY(-0.18rem) rotate(0deg);
    }
  }

  @keyframes about-badge-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.52),
        inset 0 -28px 48px color-mix(in srgb, var(--about-accent) 16%, rgba(10, 12, 18, 0.18)),
        0 0 0 1px rgba(255, 255, 255, 0.08),
        0 18px 42px rgba(0, 0, 0, 0.24),
        0 0 28px color-mix(in srgb, var(--about-accent) 18%, transparent);
    }

    50% {
      transform: scale(1.025);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.62),
        inset 0 -24px 54px color-mix(in srgb, var(--about-accent) 22%, rgba(10, 12, 18, 0.16)),
        0 0 0 1px rgba(255, 255, 255, 0.12),
        0 20px 48px rgba(0, 0, 0, 0.26),
        0 0 38px color-mix(in srgb, var(--about-accent) 28%, transparent);
    }
  }

  @keyframes about-badge-inner-pulse {
    0%,
    100% {
      opacity: 0.62;
      transform: scale(1);
    }

    50% {
      opacity: 0.86;
      transform: scale(1.018);
    }
  }

  @keyframes about-badge-glow-breathe {
    0%,
    100% {
      opacity: 0.42;
      transform: scale(0.96);
    }

    50% {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }

  @media (max-width: 780px) {
    .about-badge-line {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .about-badge-line {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .about-badge {
      width: min(13rem, 100%);
      min-height: 12.4rem;
      padding-inline: 1.2rem;
    }

    .about-badge-title {
      width: min(9rem, 78vw);
      font-size: 0.78rem;
    }

    .about-badge-detail {
      width: min(8.4rem, 74vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-badge,
    .about-badge::before,
    .about-badge::after,
    .about-badge-glow {
      animation: none;
    }
  }
</style>
