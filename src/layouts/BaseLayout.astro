---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const {
  title = 'Andy Araya',
  description = 'Creative Technologist, AI Systems Builder, and Digital Product Strategist.',
  lang = 'en'
} = Astro.props;
const siteOrigin = 'https://andyaraya.com';
const path = Astro.url.pathname;
const canonicalUrl = `${siteOrigin}${path}`;
const alternatePath = lang === 'es' ? path.replace(/^\/es/, '') || '/' : `/es${path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050507" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={`${siteOrigin}${alternatePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${lang === 'es' ? alternatePath : path}`} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-bg text-white antialiased">
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-black"
    >
      Skip to content
    </a>
    <SiteHeader locale={lang} />
    <main>
      <slot />
    </main>
    <footer class="glass-nav mt-8 border-t border-white/8">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-8 text-sm text-white/50 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <p>Andy Araya</p>
        <div class="flex flex-col items-start gap-3 lg:items-end">
          <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
            <a class="transition hover:text-white" href={lang === 'es' ? '/es/faq/' : '/faq/'}>FAQ</a>
            <a class="transition hover:text-white" href="/andy-araya-ai-profile.md">{lang === 'es' ? 'Perfil legible para IA' : 'AI-readable profile'}</a>
            <a class="transition hover:text-white" href="/privacy-policy">{lang === 'es' ? 'Política de privacidad' : 'Privacy Policy'}</a>
            <a class="transition hover:text-white" href="/terms-of-service">{lang === 'es' ? 'Términos de servicio' : 'Terms of Service'}</a>
          </nav>
          <a
            class="glass-button inline-flex items-center rounded-full px-4 py-2 text-sm font-medium text-white transition hover:border-cyan-300/40 hover:text-cyan-100"
            href="https://www.google.com/preferences/source?q=andyaraya.com"
          >
            {lang === 'es' ? 'Añadir AndyAraya.com como fuente preferida en Google' : 'Add AndyAraya.com as a preferred Google source'}
          </a>
        </div>
      </div>
    </footer>
    <script type="module">
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
