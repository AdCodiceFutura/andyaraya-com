---
const { id, eyebrow, title, intro } = Astro.props;
---

<section id={id} class="border-t border-white/6">
  <div class="mx-auto w-full max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8 lg:py-36">
    <div class="space-y-10">
      <div class="space-y-4">
        <p class="text-xs uppercase tracking-[0.28em] text-cyan-400/80">{eyebrow}</p>
        <h2 class="max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-[2.7rem]">
          {title}
        </h2>
        {intro && <p class="max-w-3xl text-base leading-7 text-white/70 sm:text-lg">{intro}</p>}
      </div>
      <slot />
    </div>
  </div>
</section>
