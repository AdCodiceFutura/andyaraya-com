---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';

const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const items = faqs[isSpanish ? 'es' : 'en'];
const title = isSpanish ? 'Preguntas frecuentes sobre automatización con IA' : 'Frequently asked questions about AI automation';
const intro = isSpanish
  ? 'Respuestas directas para empresas que evalúan automatización de procesos, sistemas de IA y desarrollo de software a medida en Costa Rica.'
  : 'Direct answers for companies evaluating process automation, AI systems, and custom software development in Costa Rica.';
---

<BaseLayout title={`${title} | Andy Araya`} description={intro} lang={locale}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  })}></script>

  <section class="faq-hero">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-300/80">{isSpanish ? 'FAQ / IA y automatización' : 'FAQ / AI and automation'}</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white sm:text-6xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-white/70">{intro}</p>
    </div>
  </section>

  <section class="border-t border-white/8">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="faq-list">
        {items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-hero { background: radial-gradient(circle at 20% 0%, rgba(34, 211, 238, 0.14), transparent 38%), #050507; }
  .faq-list { border-top: 1px solid rgba(255, 255, 255, 0.12); }
  .faq-list details { border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding: 0; }
  .faq-list summary { cursor: pointer; list-style: none; padding: 1.3rem 2.5rem 1.3rem 0; color: rgba(255, 255, 255, 0.95); font-size: 1.05rem; font-weight: 600; line-height: 1.45; position: relative; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: '+'; position: absolute; right: 0; color: #67e8f9; font-size: 1.5rem; font-weight: 400; }
  .faq-list details[open] summary::after { content: '−'; }
  .faq-list p { max-width: 70ch; margin: -0.15rem 0 0; padding: 0 2.5rem 1.4rem 0; color: rgba(255, 255, 255, 0.7); font-size: 1rem; line-height: 1.7; }
</style>
