---
const { items } = Astro.props;
---

<div class="grid gap-4">
  {items.map((item) => (
    <article class="rounded-3xl border border-white/8 bg-white/[0.03] p-5 shadow-glow transition duration-300 hover:-translate-y-0.5 hover:border-white/14 hover:bg-white/[0.05]">
      <h3 class="text-lg font-medium text-white">{item.title ?? item}</h3>
      {item.summary && <p class="mt-2 max-w-2xl text-sm leading-6 text-white/65">{item.summary}</p>}
      {item.detail && <p class="mt-2 max-w-2xl text-sm leading-6 text-white/65">{item.detail}</p>}
    </article>
  ))}
</div>
