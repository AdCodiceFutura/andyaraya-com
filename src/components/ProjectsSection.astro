---
import { projects } from '../data/projects';
---

<div class="space-y-6">
  <div class="space-y-10" data-stagger>
    {projects.map((project) => (
      <article class="border-t border-white/8 pt-8 first:border-t-0 first:pt-0" data-reveal-child>
        <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="rounded-full border border-cyan-400/20 bg-cyan-400/8 px-3 py-1 text-[0.7rem] uppercase tracking-[0.16em] text-cyan-300">
                {project.status}
              </span>
            </div>
            <h3 class="text-2xl font-medium text-white">{project.title}</h3>
            <p class="text-sm leading-7 text-white/66">{project.summary}</p>
          </div>
          <div class="ambient-panel hover-depth rounded-[1.4rem] border border-white/8 p-5 sm:grid sm:grid-cols-2 sm:gap-5">
            <div>
              <p class="text-[0.68rem] uppercase tracking-[0.18em] text-white/40">Business Problem</p>
              <p class="mt-3 text-sm leading-7 text-white/66">{project.businessProblem}</p>
            </div>
            <div>
              <p class="text-[0.68rem] uppercase tracking-[0.18em] text-white/40">Outcome</p>
              <p class="mt-3 text-sm leading-7 text-white/66">{project.outcome}</p>
            </div>
            <div class="mt-5 sm:mt-0">
              <p class="text-[0.68rem] uppercase tracking-[0.18em] text-white/40">Stack</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.stack.map((item) => (
                  <span class="rounded-full border border-white/10 px-3 py-1.5 text-xs text-white/68">
                    {item}
                  </span>
                ))}
              </div>
            </div>
            <div class="mt-5 sm:mt-0">
              <p class="text-[0.68rem] uppercase tracking-[0.18em] text-white/40">Business Value</p>
              <p class="mt-3 text-sm leading-7 text-white/66">{project.value}</p>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
  <a href="#" class="hover-depth inline-flex rounded-full border border-white/10 px-4 py-2.5 text-sm text-white/75 transition hover:border-cyan-400/25 hover:text-white" data-reveal>
    View all projects
  </a>
</div>
