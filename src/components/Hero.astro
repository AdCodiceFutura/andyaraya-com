---
import { roles } from '../data/profile';
---

<section id="home" class="hero-background relative overflow-hidden">
  <div class="hero-background-image absolute inset-0"></div>
  <div class="hero-background-shade pointer-events-none absolute inset-0"></div>
  <div class="noise-layer pointer-events-none absolute inset-0 opacity-35"></div>
  <div class="ambient-glow-purple glow-drift absolute left-[-8rem] top-10 h-[18rem] w-[18rem] rounded-full blur-3xl"></div>
  <div class="ambient-glow-cyan glow-drift-delayed absolute right-[-6rem] top-24 h-[16rem] w-[16rem] rounded-full blur-3xl"></div>
  <div class="mx-auto w-full max-w-7xl px-4 pb-80 pt-20 sm:px-6 sm:pb-92 sm:pt-24 lg:px-8 lg:pb-96 lg:pt-20">
    <div class="relative z-20">
      <div class="space-y-4 sm:space-y-5 lg:grid lg:grid-cols-3 lg:gap-8 lg:space-y-0">
        <div class="space-y-4 sm:space-y-5 lg:text-center">
          <h1 class="hero-title max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl lg:mx-auto lg:text-[3.1rem] lg:leading-[0.98]">
            <span class="hero-title-text hero-title-violet">{roles[0]}</span>
          </h1>
          <div class="glass-edge h-px w-16 bg-white/12 lg:mx-auto"></div>
        </div>

        <div class="space-y-4 sm:space-y-5 lg:text-center">
          <p class="hero-title hero-title-delay-2 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl lg:mx-auto lg:text-[3.1rem] lg:leading-[0.98]">
            <span class="hero-title-text hero-title-cyan">{roles[1]}</span>
          </p>
          <div class="glass-edge h-px w-16 bg-white/12 lg:mx-auto"></div>
        </div>

        <div class="space-y-4 sm:space-y-5 lg:text-center">
          <p class="hero-title hero-title-delay-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl lg:mx-auto lg:text-[3.1rem] lg:leading-[0.98]">
            <span class="hero-title-text hero-title-green">{roles[2]}</span>
          </p>
        </div>
      </div>

      <p class="hero-copy mt-10 max-w-3xl text-base leading-8 text-white/72 sm:text-lg lg:mx-auto lg:mt-8 lg:max-w-4xl lg:text-center lg:text-[1.05rem] lg:leading-8">
        Designing systems that transform complexity into measurable business value
      </p>
    </div>
  </div>
</section>
