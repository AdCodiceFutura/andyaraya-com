---
import { roles } from '../data/profile';

const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const localizedRoles = isSpanish
  ? ['Tecnólogo creativo', 'Constructor de sistemas de IA', 'Estratega de productos digitales']
  : roles;
const content = isSpanish
  ? {
      eyebrow: 'Automatización con IA · Costa Rica',
      title: 'Automatización con IA y sistemas a medida para empresas que buscan resultados medibles',
      copy: 'Combino estrategia de negocio, desarrollo de software y sistemas de IA para convertir procesos complejos en capacidades que generan valor económico.',
      whatsapp: 'Hablar por WhatsApp',
      services: 'Ver servicios'
    }
  : {
      eyebrow: 'AI automation · Costa Rica',
      title: 'AI automation and custom systems for companies seeking measurable results',
      copy: 'I combine business strategy, software development, and AI systems to turn complex processes into capabilities that create economic value.',
      whatsapp: 'Chat on WhatsApp',
      services: 'Explore services'
    };
---

<section id="home" class="hero-background relative overflow-hidden">
  <div class="hero-background-image absolute inset-0"></div>
  <div class="hero-background-shade pointer-events-none absolute inset-0"></div>
  <div class="noise-layer pointer-events-none absolute inset-0 opacity-35"></div>
  <div class="ambient-glow-purple glow-drift absolute left-[-8rem] top-10 h-[18rem] w-[18rem] rounded-full blur-3xl"></div>
  <div class="ambient-glow-cyan glow-drift-delayed absolute right-[-6rem] top-24 h-[16rem] w-[16rem] rounded-full blur-3xl"></div>
  <div class="mx-auto w-full max-w-7xl px-4 pb-80 pt-20 sm:px-6 sm:pb-92 sm:pt-24 lg:px-8 lg:pb-96 lg:pt-20">
    <div class="relative z-20">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200/85 lg:text-center">{content.eyebrow}</p>
      <h1 class="hero-title mt-5 max-w-5xl text-4xl font-semibold tracking-tight sm:text-5xl lg:mx-auto lg:text-center lg:text-[3.8rem] lg:leading-[1.02]">
        <span class="hero-title-text hero-title-cyan">{content.title}</span>
      </h1>
      <p class="hero-copy mt-7 max-w-3xl text-base leading-8 text-white/72 sm:text-lg lg:mx-auto lg:max-w-4xl lg:text-center lg:text-[1.05rem] lg:leading-8">
        {content.copy}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3 lg:justify-center">
        <a class="hero-whatsapp-button inline-flex items-center gap-2.5 rounded-full px-5 py-3 text-sm font-semibold text-white transition" href="https://wa.me/50689794761?text=Hola%20Andy%2C%20quiero%20conversar%20sobre%20una%20oportunidad%20de%20automatizaci%C3%B3n%20con%20IA." target="_blank" rel="noopener noreferrer">
          <span class="hero-whatsapp-button__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M20.5 11.8a8.45 8.45 0 0 1-12.47 7.43L4 20.5l1.32-3.84A8.45 8.45 0 1 1 20.5 11.8Z"></path>
              <path d="M9 8.1c.18-.42.35-.43.62-.43h.53c.17 0 .4.02.52.35l.7 1.68c.1.25.04.45-.08.62l-.42.5c-.14.16-.27.3-.12.58.15.27.66 1.08 1.42 1.76.98.87 1.8 1.14 2.06 1.27.26.13.41.11.56-.07l.71-.84c.18-.22.39-.17.65-.08l1.66.78c.25.13.42.19.48.3.06.11.06.64-.15 1.25-.21.61-1.21 1.17-1.67 1.24-.43.07-.98.1-1.59-.1-.37-.12-.85-.28-1.47-.55-2.58-1.12-4.25-3.74-4.38-3.91-.13-.18-1.05-1.4-1.05-2.67 0-1.27.67-1.9.9-2.16Z"></path>
            </svg>
          </span>
          {content.whatsapp}
        </a>
        <a class="inline-flex rounded-full border border-white/18 px-5 py-3 text-sm font-semibold text-white/80 transition hover:border-cyan-300/60 hover:text-white" href="#services">{content.services}</a>
      </div>
      <p class="mt-7 flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.13em] text-white/48 lg:justify-center">
        {localizedRoles.map((role) => <span>{role}</span>)}
      </p>
    </div>
  </div>
</section>

<style>
  .hero-whatsapp-button {
    border: 1px solid rgba(37, 211, 102, 0.52);
    background:
      radial-gradient(circle at 20% 0%, rgba(37, 211, 102, 0.2), transparent 54%),
      linear-gradient(180deg, rgba(37, 211, 102, 0.18), rgba(15, 112, 54, 0.13));
    box-shadow:
      inset 0 1px 0 rgba(204, 255, 220, 0.23),
      0 12px 30px rgba(0, 0, 0, 0.22),
      0 0 24px rgba(37, 211, 102, 0.14);
  }

  .hero-whatsapp-button:hover {
    border-color: rgba(89, 239, 145, 0.8);
    background:
      radial-gradient(circle at 20% 0%, rgba(89, 239, 145, 0.26), transparent 54%),
      linear-gradient(180deg, rgba(37, 211, 102, 0.26), rgba(15, 112, 54, 0.2));
  }

  .hero-whatsapp-button:focus-visible {
    outline: 2px solid #b9ffd0;
    outline-offset: 3px;
  }

  .hero-whatsapp-button__icon {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid rgba(174, 255, 202, 0.36);
    border-radius: 999px;
    background: rgba(14, 130, 61, 0.4);
    color: #b9ffd0;
  }

  .hero-whatsapp-button__icon svg {
    width: 0.74rem;
    height: 0.74rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.85;
  }

</style>
