---
import { navigation } from '../data/navigation';
---

<header class="sticky top-0 z-50 border-b border-white/6 bg-bg/85 backdrop-blur-xl">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="#home" class="flex items-center gap-3 text-sm font-semibold tracking-[0.14em] text-white/90">
      <span class="flex h-11 w-[4.2rem] items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-white/5 px-2 shadow-glow">
        <img
          src="/images/branding/Logo_AndyAraya.svg"
          alt="Andy Araya logo"
          class="h-full w-full object-contain"
        />
      </span>
      <span class="hidden sm:inline">Andy Araya</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {navigation.map((item) => (
        <a
          href={item.href}
          class="text-sm text-white/70 transition hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="relative lg:hidden">
      <summary class="list-none rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/85 shadow-glow">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 w-[min(18rem,calc(100vw-2rem))] rounded-3xl border border-white/10 bg-panel/95 p-3 shadow-2xl backdrop-blur-xl">
        <nav class="grid gap-1" aria-label="Mobile">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="rounded-2xl px-3 py-3 text-sm text-white/80 transition hover:bg-white/6 hover:text-white"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>
