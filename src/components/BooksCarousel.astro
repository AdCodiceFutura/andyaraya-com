---
import { books as englishBooks } from '../data/books';
import { spanishBookContent } from '../data/books-es';

const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const books = isSpanish
  ? englishBooks.map((book, index) => ({ ...book, ...spanishBookContent[index] }))
  : englishBooks;
const labels = isSpanish
  ? { navigation: 'Navegación de libros', previous: 'Libro anterior', next: 'Libro siguiente', info: 'Información del libro', quote: 'Cita favorita', takeaways: 'Ideas clave', cover: 'Portada de' }
  : { navigation: 'Book navigation', previous: 'Previous book', next: 'Next book', info: 'Book Info', quote: 'Favorite Quote', takeaways: 'Key Takeaways', cover: 'Cover of' };
---

<section class="book-viewer" data-book-viewer data-reveal-child>
  <div class="book-viewer__stage">
    <div class="book-viewer__cover-shell" aria-live="polite">
      <img
        src={books[0].cover}
        alt={`${labels.cover} ${books[0].title}`}
        class="book-viewer__cover"
        data-book-cover
        loading="lazy"
      />
    </div>

    <div class="book-viewer__controls" aria-label={labels.navigation}>
      <button type="button" class="book-viewer__step" data-book-step="-1" aria-label={labels.previous}>
        <span class="book-viewer__chevron book-viewer__chevron--left" aria-hidden="true"></span>
      </button>
      <p class="book-viewer__count" data-book-count>01 / {String(books.length).padStart(2, '0')}</p>
      <button type="button" class="book-viewer__step" data-book-step="1" aria-label={labels.next}>
        <span class="book-viewer__chevron book-viewer__chevron--right" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <article class="book-viewer__info" data-book-info>
    <p class="book-viewer__column-title">{labels.info}</p>
    <p class="book-viewer__category" data-book-category>{books[0].category}</p>
    <h3 data-book-title>{books[0].title}</h3>
    <p class="book-viewer__author" data-book-author>{books[0].author}</p>
    <p class="book-viewer__note" data-book-note>{books[0].note}</p>

    <div class="book-viewer__quote">
      <p>{labels.quote}</p>
      <span data-book-idea>{books[0].keyIdea}</span>
    </div>
  </article>

  <aside class="book-viewer__takeaways">
    <p class="book-viewer__column-title">{labels.takeaways}</p>
    <ol>
      {books[0].takeaways.map((takeaway, index) => (
        <li>
          <strong>{index + 1}</strong>
          <span data-book-takeaway-item>{takeaway}</span>
        </li>
      ))}
    </ol>
  </aside>
</section>

<script define:vars={{ books, labels }}>
  const bookWrapIndex = (index, total) => (index + total) % total;

  document.querySelectorAll('[data-book-viewer]').forEach((viewer) => {
    const cover = viewer.querySelector('[data-book-cover]');
    const category = viewer.querySelector('[data-book-category]');
    const title = viewer.querySelector('[data-book-title]');
    const author = viewer.querySelector('[data-book-author]');
    const note = viewer.querySelector('[data-book-note]');
    const idea = viewer.querySelector('[data-book-idea]');
    const takeawayItems = [...viewer.querySelectorAll('[data-book-takeaway-item]')];
    const count = viewer.querySelector('[data-book-count]');
    const steps = [...viewer.querySelectorAll('[data-book-step]')];
    let activeIndex = 0;

    const setActiveBook = (nextIndex) => {
      activeIndex = bookWrapIndex(nextIndex, books.length);
      const book = books[activeIndex];

      viewer.dataset.bookDirection = nextIndex > activeIndex ? 'next' : 'previous';
      category.textContent = book.category;
      title.textContent = book.title;
      author.textContent = book.author;
      note.textContent = book.note;
      idea.textContent = book.keyIdea;
      book.takeaways.forEach((takeaway, index) => {
        if (takeawayItems[index]) {
          takeawayItems[index].textContent = takeaway;
        }
      });
      count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(books.length).padStart(2, '0')}`;
      cover.alt = `${labels.cover} ${book.title}`;
      cover.src = book.cover;

      cover.animate(
        [
          { opacity: 0, transform: 'translateX(14px) scale(0.985)' },
          { opacity: 1, transform: 'translateX(0) scale(1)' }
        ],
        { duration: 420, easing: 'cubic-bezier(.22, 1, .36, 1)' }
      );
    };

    steps.forEach((step) => {
      step.addEventListener('click', () => {
        setActiveBook(activeIndex + Number(step.dataset.bookStep));
      });
    });

    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setActiveBook(activeIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        setActiveBook(activeIndex + 1);
      }
    });

    viewer.tabIndex = 0;
  });
</script>

<style>
  .book-viewer {
    display: grid;
    grid-template-columns: minmax(11rem, 0.72fr) minmax(14rem, 0.78fr) minmax(20rem, 1.15fr);
    gap: clamp(1.6rem, 4.5vw, 4rem);
    align-items: center;
    min-height: clamp(15rem, 23vw, 20rem);
  }

  .book-viewer__info,
  .book-viewer__takeaways {
    position: relative;
    min-height: clamp(13.5rem, 19vw, 16.5rem);
    padding-block: clamp(0.8rem, 2vw, 1.4rem);
  }

  .book-viewer__info::before,
  .book-viewer__takeaways::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 clamp(-1.5rem, -2vw, -0.8rem);
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.24), transparent);
  }

  .book-viewer__category,
  .book-viewer__count {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
  }

  .book-viewer__column-title {
    color: white;
    font-size: clamp(1.6rem, 2.55vw, 2.35rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .book-viewer__category {
    margin-top: 1.4rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .book-viewer__info h3 {
    max-width: 22rem;
    margin-top: 0.7rem;
    color: white;
    font-size: clamp(1.45rem, 2.45vw, 2.55rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .book-viewer__author {
    margin-top: 0.55rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.4;
  }

  .book-viewer__note {
    max-width: 22rem;
    margin-top: 1.15rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(0.95rem, 1.2vw, 1.02rem);
    line-height: 1.55;
  }

  .book-viewer__quote {
    max-width: 18rem;
    margin-top: 1.35rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .book-viewer__quote p {
    color: rgba(103, 232, 249, 0.78);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .book-viewer__quote span {
    display: block;
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .book-viewer__stage {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .book-viewer__cover-shell {
    position: relative;
    display: grid;
    width: min(12.5rem, 100%);
    aspect-ratio: 0.68;
    place-items: center;
  }

  .book-viewer__cover-shell::after {
    content: "";
    position: absolute;
    inset: auto 5% -1rem;
    height: 1rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    filter: blur(1.1rem);
  }

  .book-viewer__cover {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 0.3rem;
    object-fit: contain;
    box-shadow:
      14px 18px 34px rgba(0, 0, 0, 0.38),
      -10px 0 30px rgba(34, 211, 238, 0.05);
  }

  .book-viewer__takeaways ol {
    display: grid;
    gap: clamp(0.85rem, 1.7vw, 1.25rem);
    margin-top: clamp(1.3rem, 2.4vw, 2rem);
    padding: 0;
    list-style: none;
  }

  .book-viewer__takeaways li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .book-viewer__takeaways strong {
    min-width: 2.35rem;
    padding-right: 0.7rem;
    border-right: 1px solid rgba(255, 255, 255, 0.22);
    color: white;
    font-size: clamp(2rem, 3.3vw, 3.1rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.85;
  }

  .book-viewer__takeaways span {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.92rem, 1.12vw, 1.02rem);
    line-height: 1.45;
  }

  .book-viewer__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.72rem;
  }

  .book-viewer__step {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    outline: 0;
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.66);
    transition:
      background 260ms var(--motion-ease),
      color 260ms var(--motion-ease),
      transform 260ms var(--motion-ease);
  }

  .book-viewer__step:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .book-viewer__step:focus-visible {
    outline: 1px solid rgba(34, 211, 238, 0.42);
    outline-offset: 3px;
  }

  .book-viewer__chevron {
    width: 0.48rem;
    height: 0.48rem;
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
  }

  .book-viewer__chevron--left {
    transform: translateX(0.12rem) rotate(-45deg);
  }

  .book-viewer__chevron--right {
    transform: translateX(-0.12rem) rotate(135deg);
  }

  .book-viewer__count {
    min-width: 4.5rem;
    color: rgba(34, 211, 238, 0.68);
    text-align: center;
  }

  @media (max-width: 980px) {
    .book-viewer {
      grid-template-columns: minmax(9rem, 0.55fr) minmax(0, 1fr);
      gap: 2rem 2.4rem;
    }

    .book-viewer__takeaways {
      grid-column: 1 / -1;
    }

    .book-viewer__takeaways::before {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .book-viewer {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .book-viewer__info::before,
    .book-viewer__takeaways::before {
      display: none;
    }

    .book-viewer__stage {
      justify-items: start;
    }

    .book-viewer__cover-shell {
      width: min(12.5rem, 72vw);
    }

    .book-viewer__info,
    .book-viewer__takeaways {
      min-height: auto;
      padding-block: 0;
    }

    .book-viewer__takeaways ol {
      gap: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-viewer__step {
      transition: none;
    }
  }
</style>
