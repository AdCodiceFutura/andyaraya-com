---
import { books } from '../data/books';

const selectedBook = books[3];
---

<div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
  <div class="order-2 space-y-5 lg:order-1" data-stagger>
    <div class="space-y-3" data-reveal-child>
      <p class="text-[0.68rem] uppercase tracking-[0.2em] text-white/40">{selectedBook.category}</p>
      <h3 class="text-3xl font-medium text-white sm:text-4xl">{selectedBook.title}</h3>
      <p class="text-base text-white/58">{selectedBook.author}</p>
    </div>

    <p class="max-w-xl text-sm leading-7 text-white/70 sm:text-base" data-reveal-child>{selectedBook.note}</p>

    <div class="grid gap-5 border-t border-white/8 pt-5 sm:grid-cols-2" data-reveal-child>
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.18em] text-white/40">Personal Takeaway</p>
        <p class="mt-3 text-sm leading-7 text-white/68">
          {selectedBook.note}
        </p>
      </div>
      <div>
        <p class="text-[0.68rem] uppercase tracking-[0.18em] text-cyan-300/80">Key Quote / Idea</p>
        <p class="mt-3 text-sm leading-7 text-white/72">
          {selectedBook.keyIdea}
        </p>
      </div>
    </div>
  </div>

  <div class="order-1 -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0 lg:order-2" data-reveal>
    <div class="books-coverflow flex min-w-max items-end gap-5 pb-6 pt-4 lg:min-w-0 lg:justify-center">
      {books.map((book, index) => {
        const isCenter = index === 3;
        const isNear = index === 2 || index === 4;
        return (
          <article
            class:list={[
              'hover-depth relative w-[12.75rem] shrink-0 transition duration-500',
              isCenter ? 'lg:z-20 lg:translate-y-0 lg:scale-100' : '',
              isNear ? 'lg:z-10 lg:translate-y-4 lg:scale-[0.9] lg:[transform:perspective(1200px)_rotateY(var(--cover-tilt))]' : '',
              !isCenter && !isNear ? 'lg:translate-y-7 lg:scale-[0.82] lg:opacity-70' : ''
            ]}
            style={index === 2 ? '--cover-tilt: 22deg;' : index === 4 ? '--cover-tilt: -22deg;' : undefined}
          >
            <div
              class:list={[
                'rounded-[1.45rem] border p-5 shadow-[0_22px_60px_rgba(0,0,0,0.35)]',
                isCenter
                  ? 'border-cyan-400/20 bg-[linear-gradient(180deg,rgba(34,211,238,0.10),rgba(255,255,255,0.04))]'
                  : 'border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03))]'
              ]}
            >
              <div class="flex min-h-[16rem] flex-col justify-between">
                {book.cover ? (
                  <img
                    src={book.cover}
                    alt={`Cover of ${book.title}`}
                    class="h-full min-h-[16rem] w-full rounded-[1rem] object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex min-h-[16rem] flex-col justify-between rounded-[1rem] border border-white/8 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] p-4">
                    <div>
                      <p class="text-[0.68rem] uppercase tracking-[0.2em] text-white/40">{book.category}</p>
                      <h3 class="mt-4 text-2xl leading-tight text-white">{book.title}</h3>
                      <p class="mt-3 text-sm text-white/55">{book.author}</p>
                    </div>
                    <div class="h-10 rounded-2xl border border-white/8 bg-black/20"></div>
                  </div>
                )}
              </div>
            </div>
            <div class="mx-auto mt-3 h-6 w-[82%] rounded-full bg-cyan-400/8 blur-xl"></div>
          </article>
        );
      })}
    </div>
  </div>
</div>
