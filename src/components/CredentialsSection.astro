---
import { featuredCredentials } from '../data/profile';
---

<div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0" data-reveal>
  <div class="flex min-w-max gap-3 pb-3 lg:grid lg:min-w-0 lg:grid-cols-3">
    {featuredCredentials.map((item) => (
      <a
        href={item.verificationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover-depth group flex w-[17rem] shrink-0 items-center gap-4 rounded-[1.35rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] px-4 py-4 shadow-[0_0_0_1px_rgba(255,255,255,0.02),0_22px_50px_rgba(0,0,0,0.28)] transition duration-300 lg:w-auto"
      >
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-white/10 bg-black/20 text-sm text-cyan-300">
          + 
        </span>
        <div class="min-w-0 flex-1">
          <h3 class="text-sm leading-5 text-white/88">{item.title}</h3>
          <p class="mt-1 text-[0.72rem] uppercase tracking-[0.16em] text-white/40">{item.issuer}</p>
        </div>
        <span class="text-xs uppercase tracking-[0.14em] text-cyan-300">View</span>
      </a>
    ))}
  </div>
</div>
