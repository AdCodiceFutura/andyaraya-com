---
import { featuredCredentials } from '../data/profile';

const credentialAccents = ['#22d3ee', '#9d4dff', '#34d399', '#f59e0b', '#f43f5e'] as const;
const displayIssuer = (issuer: string) => issuer.replace('Universidad CENFOTEC / ', 'CENFOTEC / ');
---

<div class="credential-runway py-10" data-reveal>
  <div class="credential-line">
    {featuredCredentials.map((item, index) => (
      <a
        href={item.verificationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="credential-badge group"
        style={`--credential-accent: ${credentialAccents[index % credentialAccents.length]}; --credential-column: ${index + 2}; --credential-delay: ${index * 420}ms`}
        aria-label={`View credential: ${item.title}`}
      >
        <span class="credential-glow" aria-hidden="true"></span>
        <span class="credential-crown" aria-hidden="true">
          <span>{item.issuerMark}</span>
        </span>
        <span class="credential-title">{item.label}</span>
        <span class="credential-status">Verified</span>
        <span class="credential-issuer">{displayIssuer(item.issuer)}</span>
        <span class="credential-check" aria-hidden="true">✓</span>
      </a>
    ))}
  </div>
</div>

<style>
  .credential-runway {
    position: relative;
  }

  .credential-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10.9rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    justify-items: center;
    isolation: isolate;
  }

  .credential-badge {
    --credential-accent: #22d3ee;
    position: relative;
    display: grid;
    width: 11.8rem;
    min-height: 11.4rem;
    max-width: 100%;
    place-items: center;
    align-content: start;
    padding: 1.18rem 1.05rem 0.72rem;
    color: white;
    text-align: center;
    text-decoration: none;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.3));
    animation: credential-float 6.8s ease-in-out infinite;
    animation-delay: var(--credential-delay, 0ms);
    transition:
      transform 420ms var(--motion-ease),
      filter 420ms var(--motion-ease);
  }

  .credential-badge::before,
  .credential-badge::after {
    content: "";
    position: absolute;
    transition:
      transform 420ms var(--motion-ease),
      background 420ms var(--motion-ease),
      opacity 420ms var(--motion-ease);
  }

  .credential-badge::before {
    inset: 0.24rem 0.64rem auto;
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle at 38% 28%, rgba(255, 255, 255, 0.52), transparent 22%),
      radial-gradient(circle at 62% 72%, color-mix(in srgb, var(--credential-accent) 34%, transparent), transparent 38%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.08) 52%, color-mix(in srgb, var(--credential-accent) 18%, rgba(255, 255, 255, 0.08)));
    border: 1px solid color-mix(in srgb, var(--credential-accent) 26%, rgba(255, 255, 255, 0.36));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.52),
      inset 0 -28px 48px color-mix(in srgb, var(--credential-accent) 16%, rgba(10, 12, 18, 0.18)),
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 18px 42px rgba(0, 0, 0, 0.24),
      0 0 28px color-mix(in srgb, var(--credential-accent) 18%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    animation: credential-glass-pulse 4.8s ease-in-out infinite;
    animation-delay: calc(var(--credential-delay, 0ms) * -0.65);
    opacity: 1;
    z-index: 0;
  }

  .credential-badge::after {
    inset: 1rem 1.42rem auto;
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle at 40% 30%, rgba(255, 255, 255, 0.34), transparent 24%),
      radial-gradient(circle at 64% 68%, color-mix(in srgb, var(--credential-accent) 18%, transparent), transparent 42%),
      rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -18px 34px color-mix(in srgb, var(--credential-accent) 10%, transparent);
    animation: credential-inner-pulse 5.4s ease-in-out infinite;
    animation-delay: calc(var(--credential-delay, 0ms) * -0.8);
    opacity: 0.7;
    z-index: 1;
    transition:
      transform 420ms var(--motion-ease),
      background 420ms var(--motion-ease),
      opacity 420ms var(--motion-ease);
  }

  .credential-badge:hover {
    transform: translateY(-5px) scale(1.018);
    filter:
      drop-shadow(0 18px 26px rgba(0, 0, 0, 0.32))
      drop-shadow(0 0 15px color-mix(in srgb, var(--credential-accent) 38%, transparent));
  }

  .credential-badge:hover::before {
    transform: scale(1.018);
  }

  .credential-glow {
    position: absolute;
    inset: 0.45rem 1.4rem auto;
    height: 5.8rem;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--credential-accent) 30%, white 14%), transparent 70%);
    animation: credential-glow-breathe 4.8s ease-in-out infinite;
    animation-delay: calc(var(--credential-delay, 0ms) * -0.65);
    opacity: 0.5;
    z-index: 2;
  }

  .credential-crown,
  .credential-status,
  .credential-title,
  .credential-issuer,
  .credential-check {
    position: relative;
    z-index: 3;
  }

  .credential-crown {
    order: 1;
    display: grid;
    width: 1.72rem;
    height: 1.72rem;
    margin-top: 0.54rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--credential-accent) 42%, rgba(255, 255, 255, 0.62));
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.44rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 8px 16px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
  }

  .credential-status {
    order: 4;
    margin-top: 0.08rem;
    width: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.32rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    padding: 0;
    text-transform: uppercase;
    box-shadow: none;
  }

  .credential-title {
    order: 2;
    display: block;
    width: 8.35rem;
    min-height: 2.42rem;
    margin-top: 0.84rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.12;
    text-wrap: balance;
  }

  .credential-issuer {
    order: 3;
    display: block;
    width: 7.8rem;
    min-height: 0.78rem;
    margin-top: 0.04rem;
    color: color-mix(in srgb, var(--credential-accent) 46%, rgba(255, 255, 255, 0.86));
    font-size: 0.35rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.22;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .credential-check {
    display: none;
  }

  @keyframes credential-float {
    0%,
    100% {
      transform: translateY(0) rotate(-0.15deg);
    }

    45% {
      transform: translateY(-0.42rem) rotate(0.18deg);
    }

    70% {
      transform: translateY(-0.18rem) rotate(0deg);
    }
  }

  @keyframes credential-glass-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.52),
        inset 0 -28px 48px color-mix(in srgb, var(--credential-accent) 16%, rgba(10, 12, 18, 0.18)),
        0 0 0 1px rgba(255, 255, 255, 0.08),
        0 18px 42px rgba(0, 0, 0, 0.24),
        0 0 28px color-mix(in srgb, var(--credential-accent) 18%, transparent);
    }

    50% {
      transform: scale(1.025);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.62),
        inset 0 -24px 54px color-mix(in srgb, var(--credential-accent) 22%, rgba(10, 12, 18, 0.16)),
        0 0 0 1px rgba(255, 255, 255, 0.12),
        0 20px 48px rgba(0, 0, 0, 0.26),
        0 0 38px color-mix(in srgb, var(--credential-accent) 28%, transparent);
    }
  }

  @keyframes credential-inner-pulse {
    0%,
    100% {
      opacity: 0.62;
      transform: scale(1);
    }

    50% {
      opacity: 0.86;
      transform: scale(1.018);
    }
  }

  @keyframes credential-glow-breathe {
    0%,
    100% {
      opacity: 0.42;
      transform: scale(0.96);
    }

    50% {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }

  @media (max-width: 680px) {
    .credential-line {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .credential-line {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .credential-badge {
      width: min(13rem, 100%);
      min-height: 12.4rem;
      padding-inline: 1.2rem;
    }

    .credential-title {
      width: min(9rem, 78vw);
      font-size: 0.78rem;
    }

    .credential-issuer {
      width: min(8.4rem, 74vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-badge,
    .credential-badge::before,
    .credential-badge::after,
    .credential-glow {
      animation: none;
    }
  }
</style>
