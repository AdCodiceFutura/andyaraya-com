---
import { featuredCredentials } from '../data/profile';

const credentialAccents = ['#22d3ee', '#9d4dff', '#34d399', '#f59e0b', '#f43f5e'] as const;
const displayIssuer = (issuer: string) => issuer.replace('Universidad CENFOTEC / ', 'CENFOTEC / ');
---

<div class="credential-runway -mx-4 overflow-x-auto px-4 py-8 sm:mx-0 sm:px-0" data-reveal>
  <div class="credential-line grid min-w-[72rem] grid-cols-[repeat(7,8.3rem)] justify-between gap-10 py-4 lg:min-w-0">
    {featuredCredentials.map((item, index) => (
      <a
        href={item.verificationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="credential-badge group"
        style={`--credential-accent: ${credentialAccents[index % credentialAccents.length]}; --credential-column: ${index + 2}`}
        aria-label={`View credential: ${item.title}`}
      >
        <span class="credential-glow" aria-hidden="true"></span>
        <span class="credential-crown" aria-hidden="true">
          <span>{item.issuerMark}</span>
        </span>
        <span class="credential-title">{item.label}</span>
        <span class="credential-status">Verified</span>
        <span class="credential-issuer">{displayIssuer(item.issuer)}</span>
        <span class="credential-check" aria-hidden="true">✓</span>
      </a>
    ))}
  </div>
</div>

<style>
  .credential-runway {
    position: relative;
  }

  .credential-line {
    position: relative;
    isolation: isolate;
  }

  .credential-line::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
    z-index: -1;
  }

  .credential-badge {
    --credential-accent: #22d3ee;
    position: relative;
    display: grid;
    grid-column: var(--credential-column);
    min-height: 7.35rem;
    place-items: center;
    align-content: start;
    padding: 0.52rem 0.52rem 0.85rem;
    color: white;
    text-align: center;
    text-decoration: none;
    filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.24));
    transition:
      transform 420ms var(--motion-ease),
      filter 420ms var(--motion-ease);
  }

  .credential-badge::before,
  .credential-badge::after {
    content: "";
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 0, 94% 18%, 94% 66%, 50% 100%, 6% 66%, 6% 18%);
    transition:
      transform 420ms var(--motion-ease),
      background 420ms var(--motion-ease),
      opacity 420ms var(--motion-ease);
  }

  .credential-badge::before {
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--credential-accent) 86%, white 8%), var(--credential-accent) 36%, rgba(9, 11, 17, 0.96) 37% 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 0 0 1px color-mix(in srgb, var(--credential-accent) 36%, transparent);
    z-index: 0;
  }

  .credential-badge::after {
    inset: 0.29rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(238, 243, 248, 0.96) 74%, rgba(13, 16, 24, 0.92) 75% 100%);
    z-index: 1;
  }

  .credential-badge:hover {
    transform: translateY(-5px) scale(1.018);
    filter:
      drop-shadow(0 18px 26px rgba(0, 0, 0, 0.32))
      drop-shadow(0 0 15px color-mix(in srgb, var(--credential-accent) 38%, transparent));
  }

  .credential-badge:hover::before {
    transform: rotate(-1.5deg) scale(1.015);
  }

  .credential-glow {
    position: absolute;
    inset: 0.2rem 0.55rem auto;
    height: 2.9rem;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--credential-accent) 42%, transparent), transparent 68%);
    opacity: 0.7;
    z-index: 2;
  }

  .credential-crown,
  .credential-status,
  .credential-title,
  .credential-issuer,
  .credential-check {
    position: relative;
    z-index: 3;
  }

  .credential-crown {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    margin-top: 0.32rem;
    place-items: center;
    clip-path: polygon(50% 0, 88% 25%, 88% 75%, 50% 100%, 12% 75%, 12% 25%);
    background:
      radial-gradient(circle at 34% 26%, rgba(255, 255, 255, 0.86), transparent 18%),
      linear-gradient(145deg, color-mix(in srgb, var(--credential-accent) 88%, white 12%), color-mix(in srgb, var(--credential-accent) 72%, black 18%));
    color: rgba(5, 7, 11, 0.9);
    font-size: 0.38rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    box-shadow: 0 8px 16px color-mix(in srgb, var(--credential-accent) 24%, transparent);
  }

  .credential-status {
    margin-top: 0.28rem;
    width: min(4.85rem, 78%);
    border: 1px solid color-mix(in srgb, var(--credential-accent) 52%, rgba(10, 12, 18, 0.5));
    border-radius: 0.18rem;
    background: rgba(255, 255, 255, 0.78);
    color: rgba(12, 15, 22, 0.86);
    font-size: 0.3rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1;
    padding: 0.2rem 0.24rem 0.18rem;
    text-transform: uppercase;
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.34),
      0 6px 14px rgba(0, 0, 0, 0.12);
  }

  .credential-title {
    display: block;
    width: 88%;
    min-height: 1.75rem;
    margin-top: 0.52rem;
    color: rgba(8, 10, 15, 0.84);
    font-size: 0.5rem;
    font-weight: 800;
    line-height: 1.22;
  }

  .credential-issuer {
    display: block;
    width: 82%;
    min-height: 0.85rem;
    margin-top: 0.2rem;
    color: color-mix(in srgb, var(--credential-accent) 68%, rgba(6, 9, 14, 0.8));
    font-size: 0.34rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .credential-check {
    position: absolute;
    bottom: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    color: color-mix(in srgb, var(--credential-accent) 82%, white 8%);
    font-size: 0.64rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 18px color-mix(in srgb, var(--credential-accent) 38%, transparent);
  }

  @media (max-width: 640px) {
    .credential-line {
      min-width: 72rem;
      gap: 2.25rem;
    }

    .credential-badge {
      min-height: 7.35rem;
      padding-inline: 0.52rem;
    }
  }
</style>
