---
import { mindmapGraph } from '../data/knowledge';

const graphPayload = {
  center: mindmapGraph.center,
  categories: mindmapGraph.categories,
  relations: mindmapGraph.relations
};
---

<div class="knowledge-graph-shell glass-surface rounded-[2rem] p-1.5" data-reveal>
  <div class="knowledge-graph-stage glass-stage relative min-h-[34rem] overflow-hidden rounded-[1.6rem] sm:min-h-[38rem] lg:min-h-[42rem]">
    <canvas class="knowledge-graph-canvas" aria-label="Andy Araya knowledge graph"></canvas>

    <script type="application/json" data-knowledge-graph set:html={JSON.stringify(graphPayload)} />
  </div>
</div>

<script is:inline>
  const accentColors = {
    cyan: '#62d7ee',
    purple: '#9d6cff',
    green: '#70d6a6',
    amber: '#e7a43d',
    rose: '#e75f78'
  };

  const stages = document.querySelectorAll('.knowledge-graph-stage');

  stages.forEach((stage) => {
    const canvas = stage.querySelector('.knowledge-graph-canvas');
    const dataNode = stage.querySelector('[data-knowledge-graph]');
    if (!canvas || !dataNode) return;

    const ctx = canvas.getContext('2d');
    const graph = JSON.parse(dataNode.textContent || '{}');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;
    let hoveredNode = null;
    let settled = false;
    let frame = 0;
    let animationFrame = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = {
      x: 0,
      y: 0,
      active: false
    };

    const nodes = [];
    const links = [];
    const nodeById = new Map();
    const neighbors = new Map();

    const addNode = (node) => {
      const created = {
        id: node.id,
        label: node.label,
        type: node.type || 'item',
        accent: node.accent || 'purple',
        px: node.x,
        py: node.y,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        radius: node.radius || 3,
        mass: node.mass || 1,
        seed: nodes.length * 0.73
      };
      nodes.push(created);
      nodeById.set(created.id, created);
      neighbors.set(created.id, new Set([created.id]));
      return created;
    };

    addNode({
      ...graph.center,
      type: 'center',
      accent: 'purple',
      radius: 10.5,
      mass: 3
    });

    graph.categories.forEach((category) => {
      addNode({
        id: category.id,
        label: category.label,
        x: category.x,
        y: category.y,
        accent: category.accent,
        type: 'category',
        radius: 7,
        mass: 2
      });

      category.items.forEach((item) => {
        addNode({
          ...item,
          accent: category.accent,
          type: 'item',
          radius: 2.8,
          mass: 1
        });
      });
    });

    graph.relations.forEach((relation) => {
      const source = nodeById.get(relation.from);
      const target = nodeById.get(relation.to);
      if (!source || !target) return;

      links.push({
        source,
        target,
        kind: relation.kind
      });
      neighbors.get(source.id).add(target.id);
      neighbors.get(target.id).add(source.id);
    });

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      width = Math.max(320, Math.floor(rect.width));
      height = Math.max(320, Math.floor(rect.height));
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      nodes.forEach((node) => {
        node.x = (node.px / 100) * width;
        node.y = 28 + (node.py / 100) * (height - 76);
        node.vx = 0;
        node.vy = 0;
      });

      settled = false;
      frame = 0;
      startDrawing();
    };

    const tick = () => {
      const time = performance.now() * 0.001;

      if (!settled) {
        for (let i = 0; i < nodes.length; i += 1) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j += 1) {
            const b = nodes[j];
            const dx = b.x - a.x || 0.01;
            const dy = b.y - a.y || 0.01;
            const distanceSq = dx * dx + dy * dy;
            const distance = Math.sqrt(distanceSq);
            const force = Math.min(0.045, 80 / distanceSq);
            const fx = (dx / distance) * force;
            const fy = (dy / distance) * force;
            a.vx -= fx / a.mass;
            a.vy -= fy / a.mass;
            b.vx += fx / b.mass;
            b.vy += fy / b.mass;
          }
        }

        links.forEach((link) => {
          const dx = link.target.x - link.source.x;
          const dy = link.target.y - link.source.y;
          const distance = Math.sqrt(dx * dx + dy * dy) || 1;
          const targetDistance = link.kind === 'primary' ? 145 : link.kind === 'bridge' ? 118 : 82;
          const strength = link.kind === 'primary' ? 0.009 : link.kind === 'bridge' ? 0.006 : 0.004;
          const force = (distance - targetDistance) * strength;
          const fx = (dx / distance) * force;
          const fy = (dy / distance) * force;
          link.source.vx += fx / link.source.mass;
          link.source.vy += fy / link.source.mass;
          link.target.vx -= fx / link.target.mass;
          link.target.vy -= fy / link.target.mass;
        });
      }

      let energy = 0;
      nodes.forEach((node) => {
        const anchorX = (node.px / 100) * width;
        const anchorY = 28 + (node.py / 100) * (height - 76);
        const driftScale = reduceMotion ? 0 : node.type === 'item' ? 6.8 : node.type === 'category' ? 3.6 : 2.2;
        const driftX =
          Math.sin(time * 0.25 + node.seed) * driftScale +
          Math.sin(time * 0.13 + node.seed * 2.1) * driftScale * 0.42;
        const driftY =
          Math.cos(time * 0.22 + node.seed * 1.4) * driftScale +
          Math.cos(time * 0.11 + node.seed * 1.7) * driftScale * 0.38;
        const desiredX = anchorX + driftX;
        const desiredY = anchorY + driftY;

        node.vx += (desiredX - node.x) * (settled ? 0.008 : 0.003);
        node.vy += (desiredY - node.y) * (settled ? 0.008 : 0.003);

        if (!reduceMotion && pointer.active) {
          const dx = node.x - pointer.x;
          const dy = node.y - pointer.y;
          const distanceSq = dx * dx + dy * dy;
          const field = node.type === 'item' ? 150 : 190;

          if (distanceSq < field * field) {
            const distance = Math.sqrt(distanceSq) || 1;
            const pull = (1 - distance / field) ** 2;
            const strength = hoveredNode?.id === node.id ? -0.18 : -0.105;
            node.vx += (dx / distance) * pull * strength;
            node.vy += (dy / distance) * pull * strength;
          }
        }

        node.vx *= settled ? 0.92 : 0.72;
        node.vy *= settled ? 0.92 : 0.72;
        node.x += node.vx;
        node.y += node.vy;
        node.x = Math.max(34, Math.min(width - 34, node.x));
        node.y = Math.max(34, Math.min(height - 54, node.y));
        energy += Math.abs(node.vx) + Math.abs(node.vy);
      });

      frame += 1;
      if (frame > 180 || energy < 0.04) settled = true;
    };

    const isRelated = (node) => {
      if (!hoveredNode) return true;
      return neighbors.get(hoveredNode.id)?.has(node.id);
    };

    const drawLabel = (node, alpha) => {
      const color = node.type === 'item' ? `rgba(220,225,230,${alpha * 0.68})` : `rgba(245,247,250,${alpha * 0.86})`;
      ctx.font =
        node.type === 'center'
          ? '800 16px Inter, system-ui, sans-serif'
          : node.type === 'category'
            ? '800 14px Inter, system-ui, sans-serif'
            : '600 10px Inter, system-ui, sans-serif';
      ctx.fillStyle = color;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText(node.label, node.x, node.y + node.radius + 7);
    };

    const draw = () => {
      tick();

      ctx.clearRect(0, 0, width, height);
      const gradient = ctx.createRadialGradient(width * 0.52, height * 0.5, 10, width * 0.52, height * 0.5, Math.max(width, height) * 0.68);
      gradient.addColorStop(0, 'rgba(157,77,255,0.12)');
      gradient.addColorStop(0.45, 'rgba(20,28,36,0.18)');
      gradient.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);

      links.forEach((link) => {
        const related = !hoveredNode || link.source.id === hoveredNode.id || link.target.id === hoveredNode.id;
        const alpha = related ? 0.24 : 0.045;
        const color = link.kind === 'bridge' ? '157, 108, 255' : link.kind === 'primary' ? '235, 238, 242' : '125, 140, 155';
        ctx.strokeStyle = `rgba(${color},${alpha})`;
        ctx.lineWidth = related ? (link.kind === 'primary' ? 1.2 : 0.85) : 0.55;
        ctx.beginPath();
        ctx.moveTo(link.source.x, link.source.y);
        ctx.lineTo(link.target.x, link.target.y);
        ctx.stroke();
      });

      nodes.forEach((node) => {
        const related = isRelated(node);
        const alpha = related ? 1 : 0.18;
        const color = accentColors[node.accent] || '#d8dbe0';
        const hoverGrowth = node.type === 'item' ? 2.2 : node.type === 'category' ? 2.8 : 3.4;
        const radius = hoveredNode?.id === node.id ? node.radius + hoverGrowth : node.radius;

        ctx.beginPath();
        ctx.fillStyle = node.type === 'center' ? `rgba(190,135,255,${alpha})` : `${color}${Math.round(alpha * 255).toString(16).padStart(2, '0')}`;
        ctx.arc(node.x, node.y, radius, 0, Math.PI * 2);
        ctx.fill();

        if (node.type !== 'item' || related || hoveredNode?.id === node.id) {
          ctx.beginPath();
          ctx.strokeStyle = `rgba(255,255,255,${(node.type === 'item' ? 0.18 : 0.26) * alpha})`;
          ctx.lineWidth = node.type === 'item' ? 1 : 1.25;
          ctx.arc(node.x, node.y, radius + (node.type === 'item' ? 4 : 6), 0, Math.PI * 2);
          ctx.stroke();
        }

        if (node.type !== 'item' || related || !hoveredNode) {
          drawLabel(node, alpha);
        }
      });

      animationFrame = requestAnimationFrame(draw);
    };

    const startDrawing = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = requestAnimationFrame(draw);
    };

    const updateHover = (event) => {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      let closest = null;
      let closestDistance = 18;

      nodes.forEach((node) => {
        const dx = node.x - x;
        const dy = node.y - y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        if (distance < closestDistance) {
          closest = node;
          closestDistance = distance;
        }
      });

      if (closest !== hoveredNode) {
        hoveredNode = closest;
        canvas.style.cursor = closest ? 'pointer' : 'default';
      }

      pointer.x = x;
      pointer.y = y;
      pointer.active = true;
    };

    canvas.addEventListener('pointermove', updateHover);
    canvas.addEventListener('pointerleave', () => {
      hoveredNode = null;
      pointer.active = false;
      canvas.style.cursor = 'default';
    });

    const observer = new ResizeObserver(resize);
    observer.observe(stage);
  });
</script>

<style>
  .knowledge-graph-stage {
    background:
      radial-gradient(circle at 50% 48%, rgba(157, 77, 255, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(24, 27, 34, 0.88), rgba(9, 11, 15, 0.96));
  }

  .knowledge-graph-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .knowledge-graph-stage {
      min-height: 34rem;
    }
  }
</style>
