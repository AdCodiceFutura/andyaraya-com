---
const caseStudies = [
  {
    id: 'enterprise-ai-operations',
    number: '01',
    tabTitle: 'Enterprise AI Operations Transformation',
    status: 'active',
    title: 'Enterprise AI Operations\nTransformation',
    description:
      'A strategic operating model for reducing administrative drag, accelerating approvals, and giving leadership a real-time AI-enabled view of operations.',
    tags: ['AI Operations', 'Workflow Design', 'ROI Modeling', 'Process Intelligence', 'Executive Alignment'],
    metrics: [
      { value: 420, prefix: '$', suffix: 'K', label: 'Potential Annual Savings' },
      { value: 62, suffix: '%', label: 'Reduction in Administrative Work' },
      { value: 4.5, suffix: 'x', label: 'Faster Approval Cycles', decimals: 1 },
      { value: 8, suffix: ' Months', label: 'Estimated ROI' }
    ],
    beforeAfter: [
      { label: 'Administrative Work', before: 100, after: 38, beforeLabel: '100%', afterLabel: '38%' },
      { label: 'Approval Time', before: 100, after: 27, beforeLabel: '5.2 days', afterLabel: '1.4 days' },
      { label: 'Operational Visibility', before: 30, after: 85, beforeLabel: '30%', afterLabel: '85%' }
    ],
    opportunity:
      'Manual coordination and fragmented approvals create hidden operating costs that compound across teams.',
    process: ['Discover', 'Analyze', 'Evaluate', 'Recommend'],
    recommendation:
      'Deploy an AI operations layer that automates coordination, centralizes approvals, and gives leadership live operational visibility.'
  },
  {
    id: 'ai-revenue-intelligence',
    number: '02',
    tabTitle: 'AI-Powered Revenue Intelligence',
    status: 'coming'
  },
  {
    id: 'autonomous-content-intelligence',
    number: '03',
    tabTitle: 'Autonomous Content Intelligence System',
    status: 'coming'
  }
] as const;

const activeCaseStudy = caseStudies[0];
---

<section class="strategy-dashboard" data-strategy-dashboard data-reveal-child>
  <nav class="strategy-dashboard__tabs" aria-label="Strategic case studies">
    {caseStudies.map((study) => (
      <button
        class:list={['strategy-dashboard__tab', study.status === 'active' && 'is-active']}
        type="button"
        aria-current={study.status === 'active' ? 'true' : undefined}
        disabled={study.status !== 'active'}
      >
        <span>{study.number}</span>
        <strong>{study.tabTitle}</strong>
        {study.status !== 'active' && <em>Coming Next</em>}
      </button>
    ))}
  </nav>

  <article class="strategy-dashboard__panel glass-surface">
    <div class="strategy-dashboard__scanline" aria-hidden="true"></div>

    <section class="strategy-dashboard__hero">
      <div class="strategy-dashboard__brief">
        <p class="strategy-dashboard__kicker">CASE STUDY {activeCaseStudy.number}</p>
        <h3>{activeCaseStudy.title}</h3>
        <p>{activeCaseStudy.description}</p>

        <div class="strategy-dashboard__tags" aria-label="Methodology tags">
          {activeCaseStudy.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>

      <div class="strategy-dashboard__metrics" aria-label="Executive impact metrics">
        {activeCaseStudy.metrics.map((metric, index) => (
          <div class="strategy-metric" style={`--metric-index:${index};`}>
            <strong
              data-count
              data-value={metric.value}
              data-prefix={metric.prefix ?? ''}
              data-suffix={metric.suffix ?? ''}
              data-decimals={metric.decimals ?? 0}
            >
              {metric.prefix ?? ''}0{metric.suffix ?? ''}
            </strong>
            <span>{metric.label}</span>
            <svg class="strategy-sparkline" viewBox="0 0 180 34" preserveAspectRatio="none" aria-hidden="true">
              <path class="strategy-sparkline__shadow" d="M2 24 C24 18, 32 27, 52 18 S84 9, 102 16 S132 29, 178 8"></path>
              <path class="strategy-sparkline__line" d="M2 24 C24 18, 32 27, 52 18 S84 9, 102 16 S132 29, 178 8"></path>
            </svg>
          </div>
        ))}
      </div>

      <div class="strategy-dashboard__delta" aria-label="Before and after operational impact">
        <div class="strategy-dashboard__delta-head">
          <p>Before vs After</p>
          <span>Live operating model</span>
        </div>

        <div class="strategy-bars">
          {activeCaseStudy.beforeAfter.map((row, index) => (
            <div class="strategy-bar-row" style={`--before:${row.before}%; --after:${row.after}%; --row-index:${index};`}>
              <div>
                <strong>{row.label}</strong>
                <span>{row.beforeLabel} -> {row.afterLabel}</span>
              </div>
              <div class="strategy-bar-row__track" aria-hidden="true">
                <i class="is-before"></i>
                <i class="is-after"></i>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="strategy-dashboard__lower" aria-label="Strategic case study analysis">
      <div class="strategy-opportunity">
        <p class="strategy-dashboard__section-label">The Opportunity</p>
        <p>{activeCaseStudy.opportunity}</p>
      </div>

      <div class="strategy-process-panel">
        <p class="strategy-dashboard__section-label">Our Strategic Process</p>
        <ol class="strategy-process-line">
          {activeCaseStudy.process.map((step, index) => (
            <li style={`--step-index:${index};`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </div>

      <div class="strategy-recommendation">
        <span>Recommended Path</span>
        <p>{activeCaseStudy.recommendation}</p>
      </div>
    </section>
  </article>
</section>

<script is:inline>
  const initializeStrategyDashboards = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-strategy-dashboard]').forEach((dashboard) => {
      const counters = [...dashboard.querySelectorAll('[data-count]')];
      let hasAnimated = false;

      const formatMetric = (counter, progress) => {
        const target = Number(counter.dataset.value || 0);
        const decimals = Number(counter.dataset.decimals || 0);
        const prefix = counter.dataset.prefix || '';
        const suffix = counter.dataset.suffix || '';
        const value = target * progress;
        counter.textContent = `${prefix}${value.toFixed(decimals)}${suffix}`;
      };

      const animateCounters = () => {
        if (hasAnimated) return;
        hasAnimated = true;

        if (prefersReducedMotion) {
          counters.forEach((counter) => formatMetric(counter, 1));
          return;
        }

        const startedAt = performance.now();
        const duration = 1500;

        const tick = (now) => {
          const rawProgress = Math.min(1, (now - startedAt) / duration);
          const eased = 1 - Math.pow(1 - rawProgress, 3);
          counters.forEach((counter) => formatMetric(counter, eased));

          if (rawProgress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting) animateCounters();
        },
        { threshold: 0.08 }
      );

      observer.observe(dashboard);

      requestAnimationFrame(() => {
        const rect = dashboard.getBoundingClientRect();
        const isPartiallyVisible = rect.top < window.innerHeight && rect.bottom > 0;
        if (isPartiallyVisible) animateCounters();
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeStrategyDashboards, { once: true });
  } else {
    initializeStrategyDashboards();
  }
</script>

<style>
  .strategy-dashboard {
    display: grid;
    gap: 0.7rem;
  }

  .strategy-dashboard__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.1rem 0.05rem 0.32rem;
    scrollbar-width: none;
  }

  .strategy-dashboard__tabs::-webkit-scrollbar {
    display: none;
  }

  .strategy-dashboard__tab {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(10rem, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    min-width: clamp(15rem, 29vw, 24rem);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.7rem;
    padding: 0.58rem 0.7rem;
    color: rgba(245, 247, 250, 0.72);
    background:
      radial-gradient(circle at 20% 0%, rgba(34, 211, 238, 0.09), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.024));
    text-align: left;
    transition: border-color 260ms var(--motion-ease), color 260ms var(--motion-ease), transform 260ms var(--motion-ease);
  }

  .strategy-dashboard__tab::after {
    content: "";
    position: absolute;
    inset: auto 0.7rem 0.3rem;
    height: 1px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.92), rgba(157, 108, 255, 0.76), transparent);
    opacity: 0;
    transform: scaleX(0.42);
    transition: opacity 280ms var(--motion-ease), transform 280ms var(--motion-ease);
  }

  .strategy-dashboard__tab span {
    color: rgba(34, 211, 238, 0.82);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .strategy-dashboard__tab strong {
    overflow-wrap: anywhere;
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .strategy-dashboard__tab em {
    justify-self: end;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 0.2rem 0.34rem;
    color: rgba(220, 225, 230, 0.48);
    font-size: 0.5rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .strategy-dashboard__tab.is-active {
    border-color: rgba(34, 211, 238, 0.26);
    color: white;
    box-shadow: 0 0 34px rgba(34, 211, 238, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.09);
  }

  .strategy-dashboard__tab.is-active::after {
    opacity: 1;
    transform: scaleX(1);
    animation: strategy-tab-flow 3.8s ease-in-out infinite;
  }

  .strategy-dashboard__tab:disabled {
    cursor: default;
    opacity: 0.58;
  }

  .strategy-dashboard__panel {
    position: relative;
    overflow: hidden;
    border-radius: 1.1rem;
    padding: clamp(0.72rem, 1.35vw, 1rem);
    background:
      radial-gradient(circle at 28% 12%, rgba(34, 211, 238, 0.12), transparent 26%),
      radial-gradient(circle at 78% 24%, rgba(157, 108, 255, 0.14), transparent 30%),
      linear-gradient(135deg, rgba(18, 21, 29, 0.94), rgba(7, 9, 13, 0.92));
  }

  .strategy-dashboard__scanline {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 12%, rgba(255, 255, 255, 0.045) 42%, transparent 62%);
    opacity: 0.4;
    transform: translateX(-70%);
    animation: strategy-scanline 8s ease-in-out infinite;
    pointer-events: none;
  }

  .strategy-dashboard__hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(13rem, 0.78fr) minmax(22rem, 1.22fr) minmax(16rem, 0.88fr);
    gap: clamp(0.62rem, 1.2vw, 0.9rem);
    align-items: stretch;
  }

  .strategy-dashboard__brief,
  .strategy-dashboard__metrics,
  .strategy-dashboard__delta,
  .strategy-opportunity,
  .strategy-process-panel,
  .strategy-recommendation {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.82rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.026));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  .strategy-dashboard__brief {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 0;
    padding: 0.78rem;
  }

  .strategy-dashboard__kicker,
  .strategy-dashboard__section-label,
  .strategy-dashboard__delta-head p,
  .strategy-recommendation span {
    margin: 0;
    color: rgba(34, 211, 238, 0.82);
    font-size: 0.54rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .strategy-dashboard__brief h3 {
    margin: 0.48rem 0 0;
    color: white;
    font-size: clamp(1.25rem, 2.15vw, 2.12rem);
    font-weight: 830;
    letter-spacing: 0;
    line-height: 0.98;
    white-space: pre-line;
  }

  .strategy-dashboard__brief p:not(.strategy-dashboard__kicker) {
    margin: 0;
    max-width: 27rem;
    color: rgba(220, 225, 230, 0.72);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .strategy-dashboard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .strategy-dashboard__tags span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.28rem 0.42rem;
    color: rgba(245, 247, 250, 0.72);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.56rem;
    font-weight: 720;
    line-height: 1;
  }

  .strategy-dashboard__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.48rem;
    padding: 0.62rem;
  }

  .strategy-metric {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 6.45rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.7rem;
    padding: 0.62rem;
    background:
      radial-gradient(circle at 30% 0%, rgba(34, 211, 238, 0.1), transparent 45%),
      rgba(255, 255, 255, 0.035);
  }

  .strategy-metric::before {
    content: "";
    position: absolute;
    inset: -30% -50%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.075), transparent);
    transform: translateX(-52%) rotate(14deg);
    animation: strategy-metric-sheen 6.5s ease-in-out infinite;
    animation-delay: calc(var(--metric-index) * -0.8s);
  }

  .strategy-metric strong {
    position: relative;
    color: white;
    font-size: clamp(1.25rem, 2.15vw, 2rem);
    font-weight: 860;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .strategy-metric span {
    position: relative;
    max-width: 7rem;
    color: rgba(220, 225, 230, 0.66);
    font-size: 0.6rem;
    font-weight: 720;
    line-height: 1.35;
  }

  .strategy-sparkline {
    position: relative;
    width: 100%;
    height: 1.45rem;
    overflow: visible;
  }

  .strategy-sparkline path {
    fill: none;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .strategy-sparkline__shadow {
    stroke: rgba(157, 108, 255, 0.18);
    stroke-width: 4;
  }

  .strategy-sparkline__line {
    stroke: rgba(34, 211, 238, 0.8);
    stroke-dasharray: 210;
    animation: strategy-sparkline-flow 3.6s ease-in-out infinite;
  }

  .strategy-dashboard__delta {
    display: grid;
    gap: 0.68rem;
    min-height: 0;
    padding: 0.72rem;
  }

  .strategy-dashboard__delta-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }

  .strategy-dashboard__delta-head span {
    color: rgba(220, 225, 230, 0.54);
    font-size: 0.58rem;
    font-weight: 700;
  }

  .strategy-bars {
    display: grid;
    gap: 0.72rem;
    align-content: center;
  }

  .strategy-bar-row {
    display: grid;
    gap: 0.34rem;
  }

  .strategy-bar-row > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(245, 247, 250, 0.8);
    font-size: 0.6rem;
    font-weight: 760;
  }

  .strategy-bar-row span {
    color: rgba(34, 211, 238, 0.72);
    font-weight: 820;
  }

  .strategy-bar-row__track {
    position: relative;
    display: grid;
    gap: 0.24rem;
  }

  .strategy-bar-row__track i {
    display: block;
    height: 0.36rem;
    border-radius: 999px;
    transform-origin: left center;
  }

  .strategy-bar-row__track .is-before {
    width: var(--before);
    background: rgba(255, 255, 255, 0.12);
    animation: strategy-bar-breathe 5.8s ease-in-out infinite;
    animation-delay: calc(var(--row-index) * -0.5s);
  }

  .strategy-bar-row__track .is-after {
    width: var(--after);
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.42), rgba(157, 108, 255, 0.8));
    box-shadow: 0 0 16px rgba(34, 211, 238, 0.14);
    animation: strategy-bar-glow 4.8s ease-in-out infinite;
    animation-delay: calc(var(--row-index) * -0.45s);
  }

  .strategy-dashboard__lower {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(13rem, 0.75fr) minmax(23rem, 1.35fr) minmax(15rem, 0.9fr);
    gap: clamp(0.62rem, 1.2vw, 0.9rem);
    margin-top: clamp(0.62rem, 1.2vw, 0.9rem);
  }

  .strategy-opportunity,
  .strategy-process-panel,
  .strategy-recommendation {
    min-height: 7.2rem;
    padding: 0.72rem;
  }

  .strategy-opportunity {
    display: grid;
    gap: 0.62rem;
  }

  .strategy-opportunity p:not(.strategy-dashboard__section-label) {
    margin: 0.5rem 0 0;
    color: rgba(220, 225, 230, 0.7);
    font-size: 0.64rem;
    line-height: 1.38;
  }

  .strategy-process-panel {
    display: grid;
    align-content: center;
    gap: 0.75rem;
  }

  .strategy-process-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strategy-process-line::before {
    content: "";
    position: absolute;
    top: 0.92rem;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.14), rgba(34, 211, 238, 0.78), rgba(157, 108, 255, 0.68), rgba(34, 211, 238, 0.14));
    background-size: 220% 100%;
    animation: strategy-process-flow 4.2s ease-in-out infinite;
  }

  .strategy-process-line li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.38rem;
    color: rgba(245, 247, 250, 0.74);
    text-align: center;
  }

  .strategy-process-line li span {
    display: grid;
    place-items: center;
    width: 1.84rem;
    aspect-ratio: 1;
    border: 1px solid rgba(34, 211, 238, 0.34);
    border-radius: 999px;
    color: rgba(34, 211, 238, 0.88);
    background: rgba(8, 11, 17, 0.92);
    box-shadow: 0 0 24px rgba(34, 211, 238, 0.12);
    font-size: 0.55rem;
    font-weight: 850;
    animation: strategy-node-glow 4.4s ease-in-out infinite;
    animation-delay: calc(var(--step-index) * -0.45s);
  }

  .strategy-process-line li strong {
    font-size: 0.62rem;
    font-weight: 800;
  }

  .strategy-recommendation {
    display: grid;
    align-content: center;
    gap: 0.58rem;
    background:
      radial-gradient(circle at 18% 16%, rgba(157, 108, 255, 0.16), transparent 38%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.028));
  }

  .strategy-recommendation span {
    display: inline-flex;
    width: fit-content;
    border: 1px solid rgba(34, 211, 238, 0.26);
    border-radius: 999px;
    padding: 0.32rem 0.44rem;
    background: rgba(34, 211, 238, 0.06);
    animation: strategy-recommendation-pulse 3.6s ease-in-out infinite;
  }

  .strategy-recommendation p {
    margin: 0;
    color: rgba(245, 247, 250, 0.86);
    font-size: clamp(0.72rem, 1.05vw, 0.9rem);
    font-weight: 700;
    line-height: 1.42;
  }

  @keyframes strategy-tab-flow {
    0%, 100% {
      opacity: 0.72;
      filter: blur(0);
    }
    50% {
      opacity: 1;
      filter: blur(0.2px);
    }
  }

  @keyframes strategy-scanline {
    0%, 52% {
      transform: translateX(-80%);
    }
    100% {
      transform: translateX(80%);
    }
  }

  @keyframes strategy-metric-sheen {
    0%, 42% {
      transform: translateX(-58%) rotate(14deg);
      opacity: 0;
    }
    58% {
      opacity: 1;
    }
    100% {
      transform: translateX(58%) rotate(14deg);
      opacity: 0;
    }
  }

  @keyframes strategy-sparkline-flow {
    0% {
      stroke-dashoffset: 210;
      opacity: 0.58;
    }
    50% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -210;
      opacity: 0.58;
    }
  }

  @keyframes strategy-bar-breathe {
    0%, 100% {
      transform: scaleX(0.985);
    }
    50% {
      transform: scaleX(1);
    }
  }

  @keyframes strategy-bar-glow {
    0%, 100% {
      filter: saturate(0.9);
      transform: scaleX(0.96);
    }
    50% {
      filter: saturate(1.25);
      transform: scaleX(1.03);
    }
  }

  @keyframes strategy-process-flow {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes strategy-node-glow {
    0%, 100% {
      box-shadow: 0 0 16px rgba(34, 211, 238, 0.08);
    }
    50% {
      box-shadow: 0 0 28px rgba(34, 211, 238, 0.22);
    }
  }

  @keyframes strategy-recommendation-pulse {
    0%, 100% {
      box-shadow: 0 0 0 rgba(34, 211, 238, 0);
    }
    50% {
      box-shadow: 0 0 26px rgba(34, 211, 238, 0.11);
    }
  }

  @media (max-width: 1180px) {
    .strategy-dashboard__hero,
    .strategy-dashboard__lower {
      grid-template-columns: 1fr;
    }

    .strategy-dashboard__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .strategy-metric {
      min-height: 7rem;
    }
  }

  @media (max-width: 640px) {
    .strategy-dashboard__panel {
      padding: 0.68rem;
    }

    .strategy-dashboard__tab {
      min-width: min(19rem, 88vw);
      grid-template-columns: auto 1fr;
    }

    .strategy-dashboard__tab em {
      grid-column: 2;
      justify-self: start;
    }

    .strategy-dashboard__metrics,
    .strategy-process-line {
      grid-template-columns: 1fr;
    }

    .strategy-dashboard__brief {
