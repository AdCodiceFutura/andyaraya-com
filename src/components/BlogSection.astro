---
import { blogPosts } from '../data/blog';
---

<div class="space-y-6">
  <div class="glass-surface divide-y divide-white/8 rounded-[1.8rem] px-4 sm:px-6" data-stagger>
    {blogPosts.map((post) => (
      <a
        href={post.href}
        class="group grid gap-4 rounded-[1.25rem] py-6 transition duration-300 hover:bg-white/[0.03] sm:grid-cols-[12rem_minmax(0,1fr)_9rem]"
        data-reveal-child
      >
        <p class="pt-1 text-[0.68rem] uppercase tracking-[0.2em] text-white/40">{post.category}</p>
        <div>
          <h3 class="text-xl font-medium text-white">
            <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]">
              {post.title}
            </span>
          </h3>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-white/65">{post.excerpt}</p>
        </div>
        <div class="flex items-center gap-4 text-sm text-white/48 sm:justify-end">
          <span>{post.date}</span>
          <span>{post.readTime}</span>
        </div>
      </a>
    ))}
  </div>
  <a href="#" class="glass-button hover-depth inline-flex rounded-full px-4 py-2.5 text-sm text-white/75 transition hover:border-cyan-400/25 hover:text-white" data-reveal>
    View all articles
  </a>
</div>
